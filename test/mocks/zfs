#!/bin/sh
# TESTKIT_VERSION=2026-07-20.25
# Mock zfs for borgsnap_ng tests.
# Logs every invocation to $MOCK_LOG and keeps snapshot state in $MOCK_STATE.
# Supported: snapshot [-r], destroy [-r], list -t snap[shot]|bookmark [-H]
#            [-d 1] [-s prop] -o name [dataset], list [-H] <dataset> (plain
#            existence check, no -t), send [-i base | -t token], receive
#            [-s], get -H -o value receive_resume_token <dataset>,
#            create [-p], bookmark, hold, release
#
# MOCK_STATE line conventions:
#   "dataset@snapshot"        - a snapshot (as before)
#   "dataset#bookmark"        - a bookmark (FIX #43)
#   "dataset"                 - a bare dataset with no snapshots yet (set by
#                                `zfs create` and by `zfs receive`, needed so
#                                a plain `zfs list dataset` existence check -
#                                used by backendZfsSend, FIX #42 - can tell a
#                                created-but-empty target apart from one
#                                that doesn't exist at all)
#   "dataset::resume::TOKEN"  - a pending resume token for that dataset
#                                (FIX #44). TOKEN embeds the label it's for
#                                (format "MOCKTOKEN::<label>::<random>") so
#                                a later `send -t` can recover what's being
#                                resumed - a real zfs stream embeds this
#                                information itself; our mock has to fake it
#                                explicitly since it doesn't move real bytes.
#
# Fault injection (for testing error-path fixes, unset/empty = normal behavior):
#   MOCK_ZFS_FAIL_LIST=1        "zfs list" fails with exit 1, simulating e.g.
#                               a pool that isn't imported. FIX #37.
#   MOCK_ZFS_FAIL_SEND=1        "zfs send" fails with exit 1 (e.g. a vanished
#                               source snapshot). FIX #42.
#   MOCK_ZFS_FAIL_RECEIVE=1     "zfs receive" fails with exit 1, no resume
#                               token left behind (e.g. a full/unwritable
#                               target pool - unrecoverable, not a transient
#                               interruption). FIX #42.
#   MOCK_ZFS_INTERRUPT_RECEIVE=1  "zfs receive -s" fails with exit 1 AND
#                               leaves a resume token behind, simulating a
#                               transient interruption (network loss,
#                               process killed) rather than a hard failure.
#                               FIX #44.
#   MOCK_ZFS_FAIL_BOOKMARK=1    "zfs bookmark" fails with exit 1 (e.g. a pool
#                               that doesn't support bookmarks). FIX #43.
: "${MOCK_LOG:=/tmp/borgsnap_mock.log}"
: "${MOCK_STATE:=/tmp/borgsnap_mock.state}"
touch "$MOCK_STATE"
echo "zfs $*" >> "$MOCK_LOG"

cmd="$1"; shift
case "$cmd" in
  snapshot)
    recursive=0
    [ "$1" = "-r" ] && { recursive=1; shift; }
    snap="$1"
    grep -qxF "$snap" "$MOCK_STATE" && { echo "cannot create snapshot '$snap': dataset already exists" >&2; exit 1; }
    echo "$snap" >> "$MOCK_STATE"
    if [ "$recursive" = 1 ] && [ "${MOCK_ZFS_NO_CHILD:-0}" != 1 ]; then
      ds="${snap%@*}"; label="${snap#*@}"
      # simulate one child dataset for recursion tests (unless
      # MOCK_ZFS_NO_CHILD=1 - needed to test the genuine "recursive flag
      # set, but the dataset actually has zero children" case, FIX #52)
      echo "$ds/child@$label" >> "$MOCK_STATE"
    fi
    exit 0 ;;
  destroy)
    [ "$1" = "-r" ] && shift
    snap="$1"
    grep -vxF "$snap" "$MOCK_STATE" > "$MOCK_STATE.tmp"
    mv "$MOCK_STATE.tmp" "$MOCK_STATE" 2>/dev/null || true
    exit 0 ;;
  list)
    if [ "${MOCK_ZFS_FAIL_LIST:-0}" = 1 ]; then
      echo "cannot open 'testpool': no such pool" >&2
      exit 1
    fi
    # crude arg parse: detect -H, -t VALUE, -s VALUE, -d 1, dataset filter
    # (last non-option arg)
    H=0; ds=""; had_t=0; ttype=""; recursive=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -H) H=1 ;;
        -t) had_t=1; shift; ttype="$1" ;;
        -o|-d|-s) shift ;;
        -Hr) H=1; recursive=1 ;;
        -r) recursive=1 ;;
        -*) : ;;
        *) ds="$1" ;;
      esac
      shift
    done
    if [ "$had_t" = 1 ] && [ "$ttype" = "bookmark" ]; then
      # FIX #43: bookmark listing/existence-check. If $ds contains "#" it's
      # a specific bookmark's full name - an existence check, exit 1 if not
      # found (mirrors the FIX #42 dataset-existence-check convention).
      # Without "#" it's "list all bookmarks of this dataset" - like the
      # snapshot listing below, an empty result is a legitimate non-error.
      case "$ds" in
        *\#*)
          if ! grep -qxF "$ds" "$MOCK_STATE" 2>/dev/null; then
            echo "cannot open '$ds': bookmark does not exist" >&2
            exit 1
          fi
          [ "$H" = 0 ] && echo "NAME"
          echo "$ds"
          exit 0 ;;
        *)
          [ "$H" = 0 ] && echo "NAME"
          if [ -n "$ds" ]; then
            grep -E "^${ds}#" "$MOCK_STATE" 2>/dev/null
          else
            grep "#" "$MOCK_STATE" 2>/dev/null
          fi
          exit 0 ;;
      esac
    elif [ "$had_t" = 1 ]; then
      # existing behavior: snapshot listing/filtering, always exit 0 - an
      # empty result legitimately means "no matching snapshots yet", not
      # an error. Insertion order in MOCK_STATE already matches creation
      # order (we only ever append), so "-s creation" needs no extra
      # sorting logic here.
      [ "$H" = 0 ] && echo "NAME"
      if [ -n "$ds" ]; then
        if [ "$recursive" = 1 ]; then
          grep -E "^${ds}(/[^@#]+)?@" "$MOCK_STATE" 2>/dev/null
        else
          grep -E "^${ds}@" "$MOCK_STATE" 2>/dev/null
        fi
      else
        grep "@" "$MOCK_STATE" 2>/dev/null
      fi
      exit 0
    else
      # FIX #42: plain `zfs list [-H] dataset` with no -t - a real
      # existence check, used by backendZfsSend. Unlike the snapshot
      # listing above, a dataset that genuinely doesn't exist must fail
      # (exit 1), matching real zfs, or "does the target exist yet" would
      # be untestable.
      if [ -z "$ds" ]; then
        [ "$H" = 0 ] && echo "NAME"
        cat "$MOCK_STATE"
        exit 0
      fi
      match=$(grep -E "^${ds}(@.*)?\$" "$MOCK_STATE" 2>/dev/null | head -1)
      if [ -z "$match" ]; then
        echo "cannot open '$ds': dataset does not exist" >&2
        exit 1
      fi
      [ "$H" = 0 ] && echo "NAME"
      echo "$ds"
      exit 0
    fi
    ;;
  get)
    # FIX #44: only supports the specific invocation backendZfsSend uses:
    #   zfs get -H -o value receive_resume_token <dataset>
    # The dataset is always the last positional argument.
    ds=""
    for a in "$@"; do ds="$a"; done
    tok=$(grep "^${ds}::resume::" "$MOCK_STATE" 2>/dev/null | sed "s|^${ds}::resume::||")
    if [ -n "$tok" ]; then
      echo "$tok"
    else
      echo "-"
    fi
    exit 0 ;;
  create)
    [ "$1" = "-p" ] && shift
    ds="$1"
    grep -qxF "$ds" "$MOCK_STATE" || echo "$ds" >> "$MOCK_STATE"
    exit 0 ;;
  send)
    if [ "${MOCK_ZFS_FAIL_SEND:-0}" = 1 ]; then
      echo "cannot send: mock injected failure" >&2
      exit 1
    fi
    # FIX #44: figure out the label being sent, so it can be embedded in
    # the (fake) stream for the receive side to recover - real zfs embeds
    # this in the actual stream bytes, our mock has to do so explicitly.
    label=""
    case "$1" in
      -t)
        # resume: token format is MOCKTOKEN::<label>::<random>
        token="$2"
        label=$(echo "$token" | awk -F'::' '{print $2}')
        ;;
      -i)
        # incremental: -i <bookmark-or-snap> <dataset>@<label>
        label="${3#*@}"
        ;;
      *)
        # full: <dataset>@<label>
        label="${1#*@}"
        ;;
    esac
    printf 'MOCKSTREAM:LABEL=%s ARGS=%s\n' "$label" "$*"
    exit 0 ;;
  receive)
    ds=""
    hasF=0
    for a in "$@"; do
      case "$a" in
        -s) ;;
        -F) hasF=1 ;;
        *) ds="$a" ;;
      esac
    done
    # Always consume stdin fully, even on injected failure, so the
    # upstream mock send side never blocks on a full pipe buffer. Extract
    # the label the (fake) stream says it's carrying.
    stream=$(cat)
    label=$(printf '%s\n' "$stream" | sed -n 's/^MOCKSTREAM:LABEL=\([^ ]*\).*/\1/p' | head -1)
    # FIX #56: detect incremental (-i) vs resume (-t) vs full from the
    # embedded stream ARGS, needed to simulate real zfs's "destination
    # exists, need -F" refusal correctly - that refusal only applies to
    # full (non-incremental, non-resume) streams; an incremental/resume
    # receive is SUPPOSED to target an existing destination.
    args_field=$(printf '%s\n' "$stream" | sed -n 's/^MOCKSTREAM:LABEL=[^ ]* ARGS=\(.*\)$/\1/p' | head -1)
    is_incremental=0
    case "$args_field" in
      "-i "*|"-t "*) is_incremental=1 ;;
    esac

    if [ "${MOCK_ZFS_FAIL_RECEIVE:-0}" = 1 ]; then
      echo "cannot receive: mock injected failure" >&2
      exit 1
    fi
    if [ "${MOCK_ZFS_INTERRUPT_RECEIVE:-0}" = 1 ]; then
      echo "cannot receive: mock injected simulated interruption" >&2
      grep -v "^${ds}::resume::" "$MOCK_STATE" > "$MOCK_STATE.tmp" 2>/dev/null
    mv "$MOCK_STATE.tmp" "$MOCK_STATE" 2>/dev/null || true
      echo "${ds}::resume::MOCKTOKEN::${label}::$$" >> "$MOCK_STATE"
      exit 1
    fi

    # FIX #56: a full stream (not incremental, not resume) targeting an
    # already-existing destination without -F must be refused, matching
    # real zfs - this is exactly the sibling-target empty-parent-
    # placeholder scenario FIX #54/#56 exist to handle correctly.
    if [ "$is_incremental" != 1 ] && [ "$hasF" != 1 ] && grep -qxF "$ds" "$MOCK_STATE" 2>/dev/null; then
      echo "cannot receive new filesystem stream: destination '$ds' exists" >&2
      echo "must specify -F to overwrite it" >&2
      exit 1
    fi

    grep -qxF "$ds" "$MOCK_STATE" || echo "$ds" >> "$MOCK_STATE"
    echo "${ds}@${label:-mockreceived}" >> "$MOCK_STATE"
    # a completed receive clears any resume token that was pending for
    # this dataset
    grep -v "^${ds}::resume::" "$MOCK_STATE" > "$MOCK_STATE.tmp" 2>/dev/null
    mv "$MOCK_STATE.tmp" "$MOCK_STATE" 2>/dev/null || true
    exit 0 ;;
  bookmark)
    if [ "${MOCK_ZFS_FAIL_BOOKMARK:-0}" = 1 ]; then
      echo "cannot create bookmark: mock injected failure" >&2
      exit 1
    fi
    bmk="$2"
    grep -qxF "$bmk" "$MOCK_STATE" || echo "$bmk" >> "$MOCK_STATE"
    exit 0 ;;
  set)
    # zfs set property=value dataset - logged via the top-level MOCK_LOG
    # line already; recorded here too in case a future test wants to
    # assert on the property value itself, not just that the command ran.
    propval="$1"; ds="$2"
    propname="${propval%%=*}"
    propvalue="${propval#*=}"
    grep -vE "^${ds}::prop::${propname}::" "$MOCK_STATE" > "$MOCK_STATE.tmp" 2>/dev/null
    mv "$MOCK_STATE.tmp" "$MOCK_STATE" 2>/dev/null || true
    echo "${ds}::prop::${propname}::${propvalue}" >> "$MOCK_STATE"
    exit 0 ;;
  hold|release) exit 0 ;;
  *) exit 0 ;;
esac
