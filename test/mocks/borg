#!/bin/sh
# TESTKIT_VERSION=2026-07-20.26
# Fault injection (unset/empty = normal behavior):
#   MOCK_BORG_FAIL_CREATE_REPO=/path/to/repo   "borg create" targeting that
#     repo (matched as a substring of the repo::archive argument) fails with
#     exit 1. Used to verify FIX #36 (a failing create for one repo must be
#     reported, but must not abort backups to the other configured repos).
#   MOCK_BORG_LIST_RC=<code>   any "borg list" call exits with this code
#     instead of 0. Used to simulate BorgBase's borg-native repo states
#     (FIX #50): 15 = Repository.InvalidRepository (exists, not yet
#     init'd), 13 = Repository.DoesNotExist, or any other real borg exit
#     code for testing the "unexpected error" path.
#   MOCK_BORG_CHECK_RC=<code>   any "borg check" call exits with this code
#     instead of 0. Used to simulate a real "borg check" finding a
#     problem, for testing BORG_VERIFY's warn-not-die handling.
#   MOCK_BORG_FAIL_INIT_REPO=/path/to/repo   "borg init" targeting that
#     repo (matched as a substring of the repo argument) fails with exit
#     1. Used to verify FIX #57 (a failing init for one repo must be
#     reported, but must not abort backups to the other configured repos).
: "${MOCK_LOG:=/tmp/borgsnap_mock.log}"
echo "borg $*" >> "$MOCK_LOG"
if [ "$1" = "create" ] && [ -n "${MOCK_BORG_FAIL_CREATE_REPO:-}" ]; then
  for arg in "$@"; do
    case "$arg" in
      "${MOCK_BORG_FAIL_CREATE_REPO}"*)
        echo "$arg: Permission denied (mock fault injection)" >&2
        exit 1 ;;
    esac
  done
fi
if [ "$1" = "init" ] && [ -n "${MOCK_BORG_FAIL_INIT_REPO:-}" ]; then
  for arg in "$@"; do
    case "$arg" in
      "${MOCK_BORG_FAIL_INIT_REPO}"*)
        echo "$arg: Permission denied (mock fault injection)" >&2
        exit 1 ;;
    esac
  done
fi
if [ "$1" = "list" ] && [ -n "${MOCK_BORG_LIST_RC:-}" ] && [ "$MOCK_BORG_LIST_RC" -ne 0 ]; then
  echo "mock borg list: simulated exit $MOCK_BORG_LIST_RC (MOCK_BORG_LIST_RC)" >&2
  exit "$MOCK_BORG_LIST_RC"
fi
if [ "$1" = "check" ] && [ -n "${MOCK_BORG_CHECK_RC:-}" ] && [ "$MOCK_BORG_CHECK_RC" -ne 0 ]; then
  echo "mock borg check: simulated problem found, exit $MOCK_BORG_CHECK_RC (MOCK_BORG_CHECK_RC)" >&2
  exit "$MOCK_BORG_CHECK_RC"
fi
if [ "$1" = "extract" ]; then
  if [ -n "${MOCK_BORG_EXTRACT_RC:-}" ] && [ "$MOCK_BORG_EXTRACT_RC" -ne 0 ]; then
    echo "mock borg extract: simulated failure, exit $MOCK_BORG_EXTRACT_RC (MOCK_BORG_EXTRACT_RC)" >&2
    exit "$MOCK_BORG_EXTRACT_RC"
  fi
  # RESTORE_VERIFY testing: MOCK_BORG_EXTRACT_FILE reads back whatever is
  # REALLY there (for genuine end-to-end consistency with what the code
  # under test actually wrote as its canary file); MOCK_BORG_EXTRACT_CONTENT
  # overrides with a fixed value instead, for deliberately simulating a
  # mismatch/corruption scenario.
  if [ -n "${MOCK_BORG_EXTRACT_CONTENT:-}" ]; then
    printf '%s\n' "$MOCK_BORG_EXTRACT_CONTENT"
  elif [ -n "${MOCK_BORG_EXTRACT_FILE:-}" ] && [ -f "$MOCK_BORG_EXTRACT_FILE" ]; then
    cat "$MOCK_BORG_EXTRACT_FILE"
  fi
  exit 0
fi
exit 0
