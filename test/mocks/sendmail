#!/bin/sh
# TESTKIT_VERSION=2026-07-20.13
# Mock sendmail for mail_wrapper.sh tests. Captures the full message
# (headers + body, exactly as piped via `sendmail -t`) to $MOCK_MAIL_LOG
# for the test to grep/assert against. Ignores its own arguments (-t etc.)
# since a mock doesn't need real delivery semantics, just to record what
# it received.
: "${MOCK_MAIL_LOG:=/tmp/borgsnap_mock_mail.log}"
cat > "$MOCK_MAIL_LOG"
exit 0
